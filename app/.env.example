# Stock Miner app – production configuration (docs/RUNBOOK.md §10)
# Chain: 4663 mainnet, 46630 testnet, 31337 Anvil. RPC: use a dedicated endpoint in production.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Season addresses: from contracts/deployments/<chainId>.json after CreateSeason. Leave unset to read that file.
NEXT_PUBLIC_MINE_ADDRESS=
NEXT_PUBLIC_FRAGMENTS_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_RIG_ADDRESS=
NEXT_PUBLIC_LP_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_ORACLE_ADDRESS=
NEXT_PUBLIC_ELIGIBILITY_ADDRESS=
NEXT_PUBLIC_STOCK_ADDRESSES=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC,0xfF080c8ce2E5feadaCa0Da81314Ae59D232d4afD,0xB90A19fF0Af67f7779afF50A882A9CfF42446400,0xD5f3879160bc7c32ebb4dC785F8a4F505888de68
NEXT_PUBLIC_SEASON_ID=0
NEXT_PUBLIC_OPEN_TIME=
# Wallets: WalletConnect Cloud project id enables the WalletConnect connector (mobile wallets). Injected always works.
NEXT_PUBLIC_WC_PROJECT_ID=
# Public origin of the deployed app: base URL for the share card (og:image) and WalletConnect metadata.
NEXT_PUBLIC_APP_URL=
# Geo-fence (docs/07): on in production by default; 0 disables, 1 forces. Countries: GEOFENCE_COUNTRIES=US,CA,GB,CH
NEXT_PUBLIC_GEOFENCE=
# Dev accounts (Anvil signers in the wallet menu). Never set in production.
NEXT_PUBLIC_DEV_ACCOUNTS=
