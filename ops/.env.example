# Keeper service on Railway (docs/RUNBOOK.md §10c). Locally the scripts read
# contracts/deployments/<chainId>.json and contracts/out/ and none of this is needed.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# KEEPER_KEY=0x...          # a hot key with a little ETH; it only ever calls poke()
# MINE_ADDRESS=0x...        # used when contracts/deployments/<chainId>.json is absent (Railway)
# VAULT_ADDRESS=0x...       # only `watch` needs it (reserve alerts)
