# docker-compose.yml – season hosting (docs/RUNBOOK.md §5). Copy to .env; .env is git-ignored.
# Chain: 4663 Robinhood Chain mainnet, 46630 testnet, 31337 Anvil. Use a dedicated RPC in production.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Keeper signer: a hot wallet holding a little ETH for poke() gas. Never the guardian/treasury key.
KEEPER_KEY=
# Watcher alerts: Slack or Discord incoming webhook; warn and page levels are forwarded.
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=warn
ALERT_REPEAT_SECONDS=900
# --planned-seconds for the watcher's "> 5x planned" alert; match the season file's sizing.plannedSeconds.
PLANNED_SECONDS=10800
KEEPER_INTERVAL=30
WATCH_INTERVAL=60
# Indexer: start block defaults to the `block` recorded in contracts/deployments/<CHAIN_ID>.json.
START_BLOCK=
INDEXER_PORT=42069
POSTGRES_PASSWORD=change-me
