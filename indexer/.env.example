# RPC for the season chain (default Anvil). Ponder reads PONDER_RPC_URL_<chainId>.
PONDER_RPC_URL_31337=http://127.0.0.1:8545
# CHAIN_ID=31337
# DEPLOYMENTS_FILE=../contracts/deployments/31337.json
# SEASON_MINE_ADDRESS=0x...
# STOCK_FRAGMENTS_ADDRESS=0x...
# REDEMPTION_VAULT_ADDRESS=0x...
# START_BLOCK=0
# DATABASE_URL=postgres://...   # omit to use embedded PGlite in .ponder/
